{
  "name": "@taxdesk/tax-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript tax computation engine — no I/O, no side effects",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run --reporter=verbose src/golden",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@taxdesk/rules": "workspace:*",
    "@taxdesk/schemas": "workspace:*",
    "neverthrow": "8.1.0"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "rimraf": "6.0.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
