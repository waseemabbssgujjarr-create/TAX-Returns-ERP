{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@taxdesk/rules": ["../rules/src/index.ts"],
      "@taxdesk/rules/*": ["../rules/src/*"],
      "@taxdesk/schemas": ["../schemas/src/index.ts"],
      "@taxdesk/schemas/*": ["../schemas/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
