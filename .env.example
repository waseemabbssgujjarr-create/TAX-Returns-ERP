# ─────────────────────────────────────────────────────────────────────────────
# TaxDesk PK — Environment Variables Example
# Copy to .env on the server (never commit real secrets).
# ─────────────────────────────────────────────────────────────────────────────

# ── App mode ──────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
#
# Production (cPanel example):
#   DATABASE_URL              → iqpigeon_taxdesk_app   (runtime; RLS; no DDL)
#   DATABASE_MIGRATIONS_URL   → iqpigeon_taxdesk_migrations (migrate deploy ONLY)
#   DATABASE_DIRECT_URL       → same as migrations (Prisma Studio / shadow DB)
#
# NEVER set DATABASE_MIGRATIONS_URL on the running worker Node app — migrations
# run only during deploy (`pnpm prisma:migrate` / `pnpm cpanel:build`).
#
DATABASE_URL="postgresql://taxdesk_app:taxdesk_dev@localhost:5432/taxdesk_dev"
DATABASE_MIGRATIONS_URL="postgresql://taxdesk_migrations:taxdesk_migrations_dev@localhost:5432/taxdesk_dev"
DATABASE_DIRECT_URL="postgresql://taxdesk_migrations:taxdesk_migrations_dev@localhost:5432/taxdesk_dev"

# ── Redis (BullMQ queues — worker only) ───────────────────────────────────────
#
# Production: Upstash — use the native Redis URL (NOT the REST API URL):
#   REDIS_URL="rediss://default:PASSWORD@HOST:6379"
#
# Local dev (docker-compose): omit REDIS_URL and use host/port instead.
#
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="CHANGE_ME_64_RANDOM_BYTES"
JWT_REFRESH_SECRET="CHANGE_ME_64_RANDOM_BYTES_DIFFERENT"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Document storage ──────────────────────────────────────────────────────────
# Production MUST use google-drive (per-user Drive; no local/S3 for client docs).
# Local dev / E2E may use "local" (refused when NODE_ENV=production).
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT=".local-storage"
S3_SIGNED_URL_EXPIRY="900"

# S3/MinIO — only when STORAGE_DRIVER=s3 (not used in production for TaxDesk PK)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="taxdesk-documents"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

# Google Drive OAuth (REQUIRED when STORAGE_DRIVER=google-drive / production)
GOOGLE_OAUTH_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/integrations/google-drive/callback"
WORKER_PUBLIC_URL="http://localhost:3001"

# Production values (documentation — set on server, do not commit secrets):
# STORAGE_DRIVER="google-drive"
# GOOGLE_OAUTH_REDIRECT_URI="https://api.tax.aderalabs.tech/integrations/google-drive/callback"
# WORKER_PUBLIC_URL="https://api.tax.aderalabs.tech"

# ── OpenAI (worker only — REQUIRED in production; never NEXT_PUBLIC_*) ────────
OPENAI_API_KEY="sk-CHANGE_ME"
OPENAI_EXTRACTION_MODEL="gpt-4o"
OPENAI_CLASSIFICATION_MODEL="gpt-4o-mini"

# ── Encryption (KMS / envelope encryption) ───────────────────────────────────
ENCRYPTION_MASTER_KEY="CHANGE_ME_32_RANDOM_BYTES_BASE64"
OTP_CONTACT_SECRET="CHANGE_ME_32_RANDOM_BYTES_BASE64_DIFFERENT"

# ── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@taxdesk.pk"

# ── Public web (browser-safe only) ────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="TaxDesk PK"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Production:
# NEXT_PUBLIC_APP_URL="https://tax.aderalabs.tech"
# NEXT_PUBLIC_API_URL="https://api.tax.aderalabs.tech"

# ── Worker listen port (cPanel sets PORT; fallback for local) ─────────────────
WORKER_PORT="3001"

# ── Local E2E / demo seed (DEV ONLY) ──────────────────────────────────────────
# See `.env.e2e.example` — never commit real credentials.

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="debug"
