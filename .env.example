# ─────────────────────────────────────────────────────────────────────────────
# TaxDesk PK — Environment Variables Example
# Copy this file to .env (or .env.local for Next.js) and fill in real values.
# NEVER commit .env files with real secrets to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
#
# DATABASE_URL          → taxdesk_app (runtime; no DDL; no BYPASSRLS; not table owner)
#                         Used by the NestJS worker for ALL application queries at runtime.
#
# DATABASE_MIGRATIONS_URL → taxdesk_migrations (owner role; migrations only)
#                           Used ONLY by "prisma migrate" and CI migration steps.
#                           NEVER set this in the application runtime environment.
#                           These two values MUST use different credentials in production.
#
# DATABASE_DIRECT_URL   → Same as DATABASE_MIGRATIONS_URL for Prisma direct connections
#                         (used by Prisma Studio, introspection, and shadow DB operations).
#
DATABASE_URL="postgresql://taxdesk_app:taxdesk_dev@localhost:5432/taxdesk_dev"
DATABASE_MIGRATIONS_URL="postgresql://taxdesk_migrations:taxdesk_migrations_dev@localhost:5432/taxdesk_dev"
DATABASE_DIRECT_URL="postgresql://taxdesk_migrations:taxdesk_migrations_dev@localhost:5432/taxdesk_dev"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 64 random bytes, base64-encoded
JWT_ACCESS_SECRET="CHANGE_ME_64_RANDOM_BYTES"
JWT_REFRESH_SECRET="CHANGE_ME_64_RANDOM_BYTES_DIFFERENT"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── File Storage ───────────────────────────────────────────────────────────────
# STORAGE_DRIVER: "local" (dev/E2E only, refused in production) |
#                 "s3" (MinIO/S3-compatible) | "google-drive" (REQUIRED in production).
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT=".local-storage"
# Signed URL expiry in seconds (default 900 = 15 min) — applies to all drivers.
S3_SIGNED_URL_EXPIRY="900"

# ── S3/MinIO (only used when STORAGE_DRIVER=s3) ───────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="taxdesk-documents"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

# ── Google Drive per-user storage (REQUIRED when STORAGE_DRIVER=google-drive) ─
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console with
# the Drive API enabled. Each staff member connects their OWN Drive account
# under Settings → Storage → Google Drive — documents are never stored with a
# public/shareable link; downloads are always proxied through the worker.
GOOGLE_OAUTH_CLIENT_ID="CHANGE_ME.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="CHANGE_ME"
# Must exactly match an "Authorized redirect URI" on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/integrations/google-drive/callback"
# Public base URL of the worker — used to build the callback + signed proxy-download
# URLs when the worker sits behind a reverse proxy / different host than localhost.
WORKER_PUBLIC_URL="http://localhost:3001"

# ── OpenAI API (server-side / worker only — never expose to browser) ──────────
OPENAI_API_KEY="sk-CHANGE_ME"
OPENAI_EXTRACTION_MODEL="gpt-4o"
OPENAI_CLASSIFICATION_MODEL="gpt-4o-mini"

# ── Encryption (KMS / envelope encryption) ───────────────────────────────────
# Master key for wrapping per-firm data keys.
# Must be 32 random bytes, base64-encoded.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# In production: store in AWS Secrets Manager / HashiCorp Vault — NOT in a plain .env file.
ENCRYPTION_MASTER_KEY="CHANGE_ME_32_RANDOM_BYTES_BASE64"

# OTP contact HMAC secret — used to compute a deterministic pseudonym for portal
# login contact addresses (email/phone). Separate from ENCRYPTION_MASTER_KEY.
# Must be 32+ random bytes, base64-encoded. Different value from ENCRYPTION_MASTER_KEY.
# Same production storage requirements as ENCRYPTION_MASTER_KEY.
OTP_CONTACT_SECRET="CHANGE_ME_32_RANDOM_BYTES_BASE64_DIFFERENT"

# ── Email (transactional) ─────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@taxdesk.pk"

# ── SMS / WhatsApp ────────────────────────────────────────────────────────────
# Provider-specific; fill in when integrating
SMS_PROVIDER_API_KEY="CHANGE_ME"
WHATSAPP_BUSINESS_TOKEN="CHANGE_ME"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME"

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NestJS worker base URL for browser auth API calls (leave empty to use Next.js /auth rewrite proxy)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="TaxDesk PK"
WORKER_PORT="3001"
NODE_ENV="development"

# ── Local E2E / demo seed (DEV ONLY) ──────────────────────────────────────────
# Copy `.env.e2e.example` → `.env.e2e.local` (gitignored). Load those vars before:
#   pnpm db:seed:demo
#   pnpm --filter @taxdesk/web test:e2e -- --project=chromium e2e/auth-*.spec.ts
# Never commit real credentials. Seed never prints passwords / TOTP secrets / tokens.

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LOG_LEVEL="debug"
