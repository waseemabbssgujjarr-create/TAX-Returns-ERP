{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,

    "baseUrl": ".",
    "paths": {
      "@taxdesk/ui": ["packages/ui/src/index.ts"],
      "@taxdesk/ui/*": ["packages/ui/src/*"],
      "@taxdesk/schemas": ["packages/schemas/src/index.ts"],
      "@taxdesk/schemas/*": ["packages/schemas/src/*"],
      "@taxdesk/tax-engine": ["packages/tax-engine/src/index.ts"],
      "@taxdesk/tax-engine/*": ["packages/tax-engine/src/*"],
      "@taxdesk/rules": ["packages/rules/src/index.ts"],
      "@taxdesk/rules/*": ["packages/rules/src/*"],
      "@taxdesk/i18n": ["packages/i18n/src/index.ts"],
      "@taxdesk/i18n/*": ["packages/i18n/src/*"]
    },

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
