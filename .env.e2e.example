# ─────────────────────────────────────────────────────────────────────────────
# TaxDesk PK — Local E2E / demo seed credentials (EXAMPLE ONLY)
#
# Copy to `.env.e2e.local` (gitignored) and load before seeding / Playwright:
#   Get-Content .env.e2e.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item env:$($matches[1]) $matches[2].Trim('"') } }
#
# NEVER commit real production secrets.
# NEVER use these values outside local/CI test environments.
# The seed script never prints password / TOTP secret / tokens to logs.
# ─────────────────────────────────────────────────────────────────────────────

SEED_FIRM_SLUG="demo-firm"
SEED_STAFF_EMAIL="owner@demo.taxdesk.local"
SEED_STAFF_NAME="Demo Owner"
# Demo-only password for local E2E — replace in your private .env.e2e.local if desired
SEED_STAFF_PASSWORD="Demo-Only-Passw0rd!"

# Base32 TOTP secret shared by seed (encrypted at rest) and Playwright (generates codes at runtime)
# Generate: node -e "console.log(require('otplib').authenticator.generateSecret())"
E2E_TOTP_SECRET="JBSWY3DPEHPK3PXP"

# Playwright maps (same values as seed)
E2E_FIRM_SLUG="demo-firm"
E2E_STAFF_EMAIL="owner@demo.taxdesk.local"
E2E_STAFF_PASSWORD="Demo-Only-Passw0rd!"
# E2E_TOTP_CODE is optional — specs generate a live code from E2E_TOTP_SECRET when set

PLAYWRIGHT_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
WORKER_URL="http://localhost:3001"
